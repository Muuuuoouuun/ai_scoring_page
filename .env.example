# 커뮤니티 기여(반박·도입 결정 기록·고장 제보)를 저장할 Postgres.
# 없으면 메모리 저장소로 동작하며, 서버를 재시작하면 기여가 전부 사라집니다.
#
# 스키마 적용:  npm run db:setup
# DB 포함 테스트: npm run test:db
DATABASE_URL=postgres://user:password@localhost:5432/ais

# 익명 저자 쿠키 서명 키. 운영에서는 반드시 고정된 값을 넣어야 합니다.
# 미설정 시 프로세스마다 임시 키가 생겨, 재시작하면 기여자 신원이 끊기고
# 본인이 남긴 기록을 수정할 수 없게 됩니다.
#   openssl rand -hex 32
AIS_AUTHOR_SECRET=
